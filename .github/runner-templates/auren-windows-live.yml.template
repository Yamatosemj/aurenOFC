name: Auren - Windows real
on:
  workflow_dispatch:
    inputs:
      camada:
        description: 'Camada autorizada; ALL executa L0,L1,L2,L4,L5 (efeitos reais e API)'
        type: choice
        options: [L0, L1, L2, L4, L5, ALL]
        default: L0
      verificar_protecoes:
        description: 'Executar somente fixtures inofensivas das protecoes, sem carregar Auren'
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: auren-windows-real
  cancel-in-progress: false
jobs:
  validar:
    if: >-
      github.event_name == 'workflow_dispatch' &&
      github.event.repository.private == true &&
      github.ref == 'refs/heads/main' &&
      github.actor == github.repository_owner &&
      github.triggering_actor == github.repository_owner &&
      vars.AUREN_WINDOWS_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 3
    outputs:
      sha: ${{ steps.sha.outputs.sha }}
    steps:
      - id: sha
        env:
          REVIEWED_SHA: ${{ vars.AUREN_REVIEWED_SHA }}
        run: |
          if [[ ! "$REVIEWED_SHA" =~ ^[0-9a-f]{40}$ ]] || [[ "$REVIEWED_SHA" != "$GITHUB_SHA" ]]; then
            echo "::error::Commit fora da revisao autorizada"
            exit 1
          fi
          echo "sha=$REVIEWED_SHA" >> "$GITHUB_OUTPUT"
  live:
    needs: validar
    environment: auren-windows
    runs-on: [self-hosted, Windows, X64, auren-isolated]
    timeout-minutes: 25
    env:
      PYTHONUTF8: '1'
      PYTHONUNBUFFERED: '1'
    defaults:
      run:
        shell: powershell
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          repository: Yamatosemj/aurenOFC
          ref: ${{ needs.validar.outputs.sha }}
          persist-credentials: false
          clean: true
      - name: Validar protecoes com processos inofensivos
        if: ${{ inputs.verificar_protecoes }}
        run: |
          $testPython = Join-Path $env:USERPROFILE 'auren-remote\venv\Scripts\python.exe'
          New-Item -ItemType Directory -Force reports | Out-Null
          & $testPython -m pytest tests/test_remote_live_safety.py -q --tb=short --basetemp="$env:RUNNER_TEMP/auren-safety-$env:GITHUB_RUN_ID" --junitxml=reports/safety.xml 2>&1 | Tee-Object reports/safety.log
          exit $LASTEXITCODE
      - name: Executar escopo aprovado sob supervisao
        if: ${{ !inputs.verificar_protecoes }}
        env:
          LAYER: ${{ inputs.camada }}
        run: |
          $ErrorActionPreference = 'Stop'
          $testPython = Join-Path $env:USERPROFILE 'auren-remote\venv\Scripts\python.exe'
          if (-not (Test-Path -LiteralPath $testPython)) { throw 'Ambiente revisado ausente' }
          # Chave existente fica no PC; nunca precisa ser copiada para secrets do GitHub.
          if (-not $env:OPENAI_API_KEY) { $env:OPENAI_API_KEY = [Environment]::GetEnvironmentVariable('OPENAI_API_KEY', 'User') }
          if ($env:OPENAI_API_KEY) { Write-Output "::add-mask::$env:OPENAI_API_KEY" }
          & $testPython remote_tests/windows_watchdog.py --camada $env:LAYER
          exit $LASTEXITCODE
      - name: Resumo
        if: always()
        env:
          LIVE_STATUS: ${{ job.status }}
          REVIEWED_SHA: ${{ needs.validar.outputs.sha }}
        run: |
          "### Windows real: $env:LIVE_STATUS" >> $env:GITHUB_STEP_SUMMARY
          "Commit revisado: $env:REVIEWED_SHA" >> $env:GITHUB_STEP_SUMMARY
          if (Test-Path reports/watchdog.json) { Get-Content reports/watchdog.json | Out-File $env:GITHUB_STEP_SUMMARY -Append -Encoding utf8 }
          if (Test-Path logs/testes/RESULTADO_TESTE_AUREN.txt) {
            Get-Content logs/testes/RESULTADO_TESTE_AUREN.txt -TotalCount 8 | Out-File $env:GITHUB_STEP_SUMMARY -Append -Encoding utf8
          }
      - name: Publicar somente evidencias selecionadas
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: auren-windows-real-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            reports/
            logs/testes/RESULTADO_TESTE_AUREN.txt
          if-no-files-found: warn
          retention-days: 7
